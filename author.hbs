{{!< default}}
{{> header}}

{{#author}}
<section class="author-profile">
  <h1>{{name}}</h1>
  {{#if bio}}
    <p>{{bio}}</p>
  {{/if}}
</section>
{{/author}}

<section class="post-feed">
  {{#foreach posts}}
    <article class="post-card">
      <h2><a href="{{url}}">{{title}}</a></h2>
    </article>
  {{/foreach}}
</section>

{{pagination}}

{{> footer}}
