<article class="project-card {{type}}">
  <div class="card-media">
    {{#if feature_image}}
      <img src="{{img_url feature_image}}" alt="{{title}}" />
    {{/if}}
  </div>
  <div class="card-overlay">
    <h3 class="card-title">{{title}}</h3>
    {{#if meta}}
      <p class="card-meta">{{meta}}</p>
    {{/if}}
  </div>
</article>
