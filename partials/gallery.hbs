<div class="gallery">
  {{#foreach images}}
    {{#if url}}
      <figure>
        <img src="{{url}}" alt="{{caption}}" loading="lazy" />
        {{#if caption}}<figcaption>{{caption}}</figcaption>{{/if}}
      </figure>
    {{else}}
      <figure>
        <img src="{{this}}" alt="Gallery image" loading="lazy" />
      </figure>
    {{/if}}
  {{/foreach}}
</div>
